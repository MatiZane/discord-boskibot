# Token bota z Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Darmowy klucz API z Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model Gemini (domyślnie aktualny szybki model z darmowego tiera Flash)
GEMINI_MODEL=gemini-flash-latest

# Prefiks komend tekstowych (domyślnie !)
COMMAND_PREFIX=!

# Opcjonalnie: ID serwera/serwerów Discord po przecinku (slash-komendy / pojawiają się natychmiast)
GUILD_ID=

# Opcjonalnie: własne emotki serwera do komendy !s / /ship (np. <:miku_heart:123456789012345678>)
SHIP_EMOJI_HIGH=
SHIP_EMOJI_MID=
SHIP_EMOJI_LOW=

# Cooldown AI w sekundach na użytkownika oraz długość pamięci rozmowy per kanał
AI_COOLDOWN_SECONDS=4
AI_HISTORY_TURNS=10

# Czas bezczynności na kanale głosowym przed automatycznym wyjściem (w sekundach)
VOICE_IDLE_SECONDS=300

# Opcjonalna ręczna ścieżka do ffmpeg.exe (puste = automatyczne wykrycie lub wbudowany imageio-ffmpeg)
FFMPEG_PATH=
